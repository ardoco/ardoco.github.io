---
import type { CollectionEntry } from 'astro:content';
import VenueBadge from './VenueBadge.astro';
import CopyButton from './CopyButton.astro';
import BibMark from '../BibMark.astro';
import DoiMark from '../DoiMark.astro';
import LinkMark from '../LinkMark.astro';
import ScholarMark from '../ScholarMark.astro';
import { citationsFor, scholarKey, scholarPaperUrl } from '../../lib/citations';
import { conferencePath } from '../../lib/urls';
import { getPage } from '../../lib/pages';

interface Props {
  pub: CollectionEntry<'publications'>;
  /** Surname (lowercased) -> /people/#anchor, from src/lib/people.ts. */
  links?: Map<string, string>;
  /** Drop the venue line and BibTeX block, for use inside a paper page. */
  compact?: boolean;
}

const { pub, links, compact = false } = Astro.props;
const d = pub.data;
/* The words on every entry: src/content/pages/site/publication.md. */
const { label, plural } = await getPage('site/publication');

const venueLine = [
  d.booktitle ?? d.journal ?? d.school ?? d.institution,
  d.location,
  d.year,
].filter(Boolean);

const pagePath = d.infoSlug ? conferencePath(d.infoSlug) : undefined;
const bibId = `bib-${pub.id}`;

const key = await scholarKey(pub);
const citationCount = await citationsFor(key);
const scholarUrl = scholarPaperUrl(key);
const Cites = scholarUrl ? 'a' : 'span';
---

<article class="entry" id={pub.id}>
  <div class="badge">
    <VenueBadge abbr={d.abbr} />
  </div>

  <div class="body">
    <h3>
      {pagePath ? (
        <a class="title-link" href={pagePath}>
          {d.title}
          <span class="sr-only"> ({label('hasPage')})</span>
        </a>
      ) : (
        d.title
      )}
      <span class="title-icons">
        {d.doi && (
          <a
            class="title-icon"
            href={`https://doi.org/${d.doi}`}
            rel="noopener"
            title={label('doi')}
            aria-label={`${label('doi')}: ${d.title}`}
          >
            <DoiMark />
          </a>
        )}
        {!d.doi && d.url && (
          /* The DOI icon is the better permalink; this is the fallback. */
          <a
            class="title-icon link-icon"
            href={d.url}
            rel="noopener"
            title={label('link')}
            aria-label={`${label('link')}: ${d.title}`}
          >
            <LinkMark />
          </a>
        )}
        {!compact && (
          <button
            class="title-icon bib-toggle"
            type="button"
            aria-expanded="false"
            aria-controls={bibId}
            aria-label={`${label('bibtex')}: ${d.title}`}
            title={label('bibtex')}
            hidden
          >
            <BibMark />
          </button>
        )}
        {citationCount > 0 && (
          <Cites
            class="title-icon cites"
            title="Citations according to Google Scholar"
            {...(scholarUrl ? { href: scholarUrl, rel: 'noopener' } : {})}
          >
            <ScholarMark />
            <span class="count mono" aria-hidden="true">
              {citationCount}
            </span>
            <span class="sr-only">{plural('citations', citationCount)} on Google Scholar</span>
          </Cites>
        )}
      </span>
    </h3>

    <p class="authors">
      {d.authors.map((a, i) => {
        const href = links?.get(a.last.toLowerCase());
        const name = `${a.first} ${a.last}`.trim();
        return (
          <>
            {i > 0 && ', '}
            {href ? <a href={href}>{name}</a> : name}
          </>
        );
      })}
    </p>

    {venueLine.length > 0 && <p class="venue-line">{venueLine.join(' · ')}</p>}

    {!compact && (
      <div class="bib-body" id={bibId}>
        <CopyButton target={`${bibId}-text`} />
        <pre id={`${bibId}-text`}>{d.bibtex}</pre>
      </div>
    )}
  </div>
</article>

<script>
  // Without JS the BibTeX stays open and the button stays hidden.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button.bib-toggle')) {
    const panel = document.getElementById(btn.getAttribute('aria-controls')!);
    if (!panel) continue;
    panel.hidden = true;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    });
  }
</script>

<style>
  /* minmax(0, 1fr) rather than 1fr: a plain 1fr track refuses to shrink below
     its content, and the wide BibTeX <pre> then pushes the whole row past the
     viewport instead of scrolling inside its own box. */
  .entry {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
  }
  .entry:target {
    background: var(--sec-dim);
    border-radius: var(--radius-m);
    padding-inline: 0.9rem;
  }
  .badge {
    padding-top: 0.2rem;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 0.3rem;
  }
  /* Underlined at rest: the one cue that a title leads to a page of ours. */
  .title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--sec) 70%, transparent);
    text-decoration-skip-ink: auto;
    text-underline-offset: 0.18em;
  }
  .title-link:hover {
    color: var(--sec-strong);
    text-decoration-color: var(--sec-strong);
    text-decoration-thickness: 2.5px;
  }

  /* Beside the title, not inside its link, so the underline stops at the text.
     The group does not break, so the icons never split across lines. */
  .title-icons {
    white-space: nowrap;
  }
  .title-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-inline-start: 0.4em;
    vertical-align: -0.1em;
    transition:
      translate var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }
  a.title-icon:hover,
  a.title-icon:focus-visible,
  button.title-icon:hover,
  button.title-icon:focus-visible {
    translate: 0 -1px;
    filter: brightness(1.12);
  }
  /* The BibTeX control is a button: strip the UA chrome. */
  .bib-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .title-icon[hidden] {
    display: none;
  }
  .bib-toggle[aria-expanded='true'] {
    filter: brightness(1.25);
  }
  .link-icon {
    color: var(--text-muted);
  }
  .cites {
    color: #5b9bff;
    text-decoration: none;
  }
  .count {
    font-size: 0.78rem;
    line-height: 1;
    color: #a9c7ff;
  }

  .authors {
    margin: 0 0 0.2rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .venue-line {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-faint);
    font-style: italic;
  }

  .bib-body {
    position: relative;
    margin-top: 0.6rem;
  }
  .bib-body pre {
    margin: 0;
    max-height: 22rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
    .badge {
      padding-top: 0;
    }
  }
</style>
