---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { intrinsic } from '../lib/images';

interface Props {
  /** An SVG under public/ by its path, or a raster from src/assets/ (see content.config.ts). */
  src: string | ImageMetadata;
  alt: string;
  plate?: boolean;
  /** Plain text under the image. The approach figure has none; a gallery image may. */
  caption?: string;
}
const { src, alt, plate = true, caption } = Astro.props;

const isVector = typeof src === 'string';
const { width, height } = isVector ? intrinsic(src) : src;

/*
 * How wide the figure is allowed to get.
 *
 * The approach diagrams are small and wide (icsa25-transarc.svg is 337x110;
 * despite its name it depicts ExArch).
 * Stretched across the full 1120px column they dominate the page and dwarf the
 * text they illustrate, so vectors are capped at roughly the prose measure.
 *
 * Raster images are capped at their own pixel width instead: the 2019 poster is
 * 1010px across, and scaling it past that is what made it look soft.
 */
const maxWidth = isVector ? 'var(--measure)' : `${width}px`;
---

<figure class:list={['figure', plate && 'has-plate']} style={`--fig-max: ${maxWidth}`}>
  {/* A raster goes through the image pipeline at its own size (WebP, hashed
       URL); an SVG is served as it is. */}
  {isVector ? (
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  ) : (
    <Image src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    max-width: min(100%, var(--fig-max));
    margin: 0 auto 1.75rem;
  }
  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
  }
  /*
   * The approach diagrams are dark line art on a transparent background, drawn
   * for a white page. On a near-black one they are all but invisible, so they
   * sit on a light plate. Screenshots, which bring their own background, opt
   * out with `plate: false`.
   */
  .has-plate img {
    background: var(--plate);
    padding: 0.9rem;
  }
  /* Secondary to the image and to the prose around it: small and muted, so a
     caption does not read as the next paragraph. */
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
