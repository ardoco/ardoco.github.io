---
import { SITE } from '../consts';
import { getPage, need } from '../lib/pages';
import Email from './Email.astro';

/* The words are src/content/pages/site/footer.md, its body the affiliation;
   the "built with" credit is the theme's and stays here. */
const footer = await getPage('site/footer');
const holder = need(footer.data.copyright, 'site/footer.copyright');
const links = footer.links();
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap inner">
    {/* A div, not a <p>: the affiliation is a Markdown body, which brings its
        own paragraph, set inline here. */}
    <div class="meta">
      &copy; {year} {holder} &middot; <footer.Content />
      {/* Every {' '} here is load-bearing: Astro strips the newline before an
          <a>, which would render "Astro andStudia Theme". */}
      &middot; website built with <a href="https://astro.build/">Astro</a> and{' '}
      <a href="https://github.com/dfuchss/astro-studia">Studia Theme</a>
    </div>
    <p class="links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <Email address={SITE.email} />
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: 2rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  p {
    margin: 0;
  }
  /* What the paragraph it replaces had from base.css; the body's own <p> is
     inline, so the block that wraps the lines is this one. */
  .meta {
    text-wrap: pretty;
  }
  .meta :global(p) {
    display: inline;
  }
  .links {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }
</style>
