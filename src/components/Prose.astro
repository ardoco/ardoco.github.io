---
/**
 * Wrapper for rendered markdown.
 *
 * The only place in the site with `is:global` styles, because these target
 * remark's output, which Astro's scoped-style attributes never reach.
 */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    max-width: var(--measure);
  }
  .prose > :first-child {
    margin-top: 0;
  }

  .prose h2 {
    margin-top: 2.25rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  .prose h3 {
    margin-top: 1.75rem;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
    margin: 0 0 1em;
  }
  .prose li {
    margin-bottom: 0.4em;
  }

  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--sec-line);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    background: var(--sec-dim);
    color: var(--text-muted);
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  .prose img {
    border-radius: var(--radius-m);
  }
  /* Loose SVGs in body copy are the same dark-on-transparent line art the
     Figure component plates; keep them readable here too. */
  .prose img[src$='.svg'] {
    background: #fff;
    padding: 0.75rem;
  }

  .prose table {
    display: block;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* ---- inline icons (replacing Font Awesome in the ASE 2026 bodies) ---- */
  .prose .ti {
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.18em;
    color: var(--ti, var(--text-faint));
    flex: none;
  }

  .prose ul.tool-landscape {
    padding-left: 0;
    list-style: none;
  }
  .prose ul.tool-landscape > li {
    margin-bottom: 1.1rem;
  }
  .prose ul.tool-landscape > li > .ti:first-child {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.4em;
  }
  .prose .tool-links {
    display: inline-block;
    margin-left: 1.6em;
    font-size: var(--fs-small);
  }

  /* ---- screencast ---- */
  .prose .video {
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-1);
  }
  .prose .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
