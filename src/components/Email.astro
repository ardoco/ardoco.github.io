---
/**
 * An email address that is readable to people and useless to scrapers.
 *
 * The al-folio site used jekyll-email-protect, which emitted HTML numeric
 * character references. That stops a naive regex and nothing else: one
 * unescape pass and the address is back, which is exactly what a harvester
 * does. The address is never present in the served bytes here — not raw, not
 * entity-encoded. It is rot13'd in data attributes and assembled on load.
 *
 * Without JS the visible text still reads "ardoco (at) lists.kit.edu", so the
 * address remains usable; it just is not a clickable mailto:.
 */
interface Props {
  /** The real address, e.g. "ardoco@lists.kit.edu". */
  address: string;
  /** Link text; defaults to the obfuscated address itself. */
  label?: string;
  class?: string;
}

const { address, label, class: className } = Astro.props;

const at = address.lastIndexOf('@');
if (at < 1) throw new Error(`Email: "${address}" is not an address`);
const user = address.slice(0, at);
const host = address.slice(at + 1);

const rot13 = (s: string) =>
  s.replace(/[a-z]/gi, (c) => {
    const base = c <= 'Z' ? 65 : 97;
    return String.fromCharCode(((c.charCodeAt(0) - base + 13) % 26) + base);
  });

// The readable fallback, and the only form of the address in the HTML.
const shown = label ?? `${user} (at) ${host.replace(/\./g, ' (dot) ')}`;
---

<span
  class:list={['email', className]}
  data-u={rot13(user)}
  data-h={rot13(host)}
  data-label={label ? '' : undefined}>{shown}</span
>

<script>
  const rot13 = (s: string) =>
    s.replace(/[a-z]/gi, (c) => {
      const base = c <= 'Z' ? 65 : 97;
      return String.fromCharCode(((c.charCodeAt(0) - base + 13) % 26) + base);
    });

  for (const el of document.querySelectorAll<HTMLElement>('span.email[data-u][data-h]')) {
    const address = `${rot13(el.dataset.u!)}@${rot13(el.dataset.h!)}`;
    const a = document.createElement('a');
    a.href = `mailto:${address}`;
    a.className = el.className;
    // A custom label stays; the "(at)" fallback is replaced by the real thing
    // now that there is a working link to attach it to.
    a.textContent = el.dataset.label === undefined ? address : el.textContent;
    el.replaceWith(a);
  }
</script>

<style>
  .email {
    overflow-wrap: anywhere;
  }
</style>
