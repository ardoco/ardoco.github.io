---
import Base from '../layouts/Base.astro';
---

<Base title="not found" description="This page does not exist.">
  <section class="wrap notfound">
    <p class="kicker">404</p>
    <h1>No such page</h1>
    <p class="lede">
      The address you followed does not exist here. It may have been a paper page that moved, or a
      link that was never quite right.
    </p>
    <p class="actions">
      <a class="chip" href="/">Home</a>
      <a class="chip" href="/approaches/">Approaches</a>
      <a class="chip" href="/conferences/">Conferences</a>
      <a class="chip" href="/publications/">Publications</a>
    </p>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(3rem, 12vw, 7rem);
    text-align: center;
  }
  .kicker {
    justify-content: center;
    font-size: 1rem;
  }
  .lede {
    max-width: 48ch;
    margin-inline: auto;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
</style>
