---
import Base from '../layouts/Base.astro';
import { getPage, need } from '../lib/pages';

/* The words, and the chips under them: src/content/pages/404.md. */
const page = await getPage('404');
const links = page.links();
---

<Base {...page.meta()}>
  <section class="wrap notfound">
    <p class="kicker">404</p>
    <h1>No such page</h1>
    <p class="lede">{need(page.data.lede, '404.lede')}</p>
    <p class="actions">
      {links.map((link) => (
        <a class="chip" href={link.href}>
          {link.label}
        </a>
      ))}
    </p>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(3rem, 12vw, 7rem);
    text-align: center;
  }
  .kicker {
    justify-content: center;
    font-size: 1rem;
  }
  .lede {
    max-width: 48ch;
    margin-inline: auto;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
</style>
