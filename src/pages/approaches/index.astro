---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ApproachMap from '../../components/ApproachMap.astro';
import Artifacts from '../../components/Artifacts.astro';
import VenueBadge from '../../components/pub/VenueBadge.astro';
import { APPROACH_GROUPS, type ApproachGroup } from '../../consts';
import { ordered, relatedVenues } from '../../lib/approaches';
import { intrinsic } from '../../lib/images';
import { paperHref } from '../../lib/publications';
import { approachPath } from '../../lib/urls';
import { getPage, need } from '../../lib/pages';

/* The words: src/content/pages/approaches.md. */
const page = await getPage('approaches');

/*
 * Section headings; the group key is the `## kicker` above each. Headings stay in the template (see the
 * `pages` collection in content.config.ts); the sentence under each is
 * `intros.<group>` in approaches.md.
 */
const GROUPS: Record<ApproachGroup, { heading: string }> = {
  tlr: { heading: 'Traceability link recovery' },
  consistency: { heading: 'Consistency analysis' },
  tools: { heading: 'Tools' },
};

/*
 * One card per approach. The thumbnail is `figure.thumb ?? figure.src`; a
 * thumb is a screenshot with a background of its own, so it gets no plate.
 */
const cards = await Promise.all(
  ordered(await getCollection('approaches')).map(async (a) => {
    const f = a.data.figure;
    const thumb = f && {
      src: f.thumb ?? f.src,
      plate: f.thumb ? false : f.plate,
      ...intrinsic(f.thumb ?? f.src),
    };
    return { a, thumb, venues: await relatedVenues(a) };
  }),
);

/* Groups with nothing in them are left out, heading and all. */
const sections = APPROACH_GROUPS.map((group) => ({
  group,
  ...GROUPS[group],
  cards: cards.filter((c) => c.a.data.group === group),
})).filter((s) => s.cards.length > 0);

/* Datasets, in file order, each with the paper that introduces it. */
const datasets = await Promise.all(
  (await getCollection('datasets')).map(async (d) => {
    const pub = d.data.publication ? await getEntry(d.data.publication) : undefined;
    return { d, pub, paper: pub && paperHref(pub) };
  }),
);
---

<Base {...page.meta()} section="approaches">
  <div class="wrap head">
    <p class="kicker" data-sigil="##">
      approaches
    </p>
    <h1>What ARDoCo builds</h1>
    <p class="lede">{need(page.data.lede, 'approaches.lede')}</p>
  </div>

  <section class="wrap block" id="map" aria-labelledby="map-heading">
    <p class="kicker" data-sigil="##">
      map
    </p>
    <h2 id="map-heading">How the approaches connect</h2>
    <p class="intro">{page.text('intros', 'map')}</p>
    <ApproachMap />
  </section>

  {sections.map((s) => (
    <section class="wrap block" id={s.group} aria-labelledby={`${s.group}-heading`}>
      <p class="kicker" data-sigil="##">
        {s.group}
      </p>
      <h2 id={`${s.group}-heading`}>{s.heading}</h2>
      <p class="intro">{page.text('intros', s.group)}</p>

      <ul class="grid">
        {s.cards.map(({ a, thumb, venues }) => (
          <li class="reveal">
            {/* The title's link is stretched over the whole card (::after),
                so the card stays one big target without wrapping the venue
                badges, which are links themselves, in a second <a>. They
                sit above the stretched area. No code link here: most
                approaches share the ardoco/ardoco monorepo, so it would not
                tell the cards apart; each approach page lists its repos. */}
            <article class="card item">
              {thumb && (
                <div class:list={['thumb', thumb.plate && 'has-plate']}>
                  {/* alt="": the card's name is its title link, and at this
                      size the diagram is decoration. Its description is
                      the figure's alt on the approach page, where it can be
                      read. */}
                  <img
                    src={thumb.src}
                    alt=""
                    width={thumb.width}
                    height={thumb.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <h3>
                <a class="title" href={approachPath(a.id)}>
                  {a.data.title}
                </a>
              </h3>
              <p class="desc">{a.data.description}</p>
              {a.data.artifacts.length > 0 && <Artifacts pairs={a.data.artifacts} />}
              <div class="foot">
                {venues.length > 0 && (
                  <div class="venues above">
                    {venues.map((abbr) => (
                      <VenueBadge abbr={abbr} />
                    ))}
                  </div>
                )}
                <p class="actions">
                  <span class="more" aria-hidden="true">
                    {page.label('more')} <span class="arrow">&rarr;</span>
                  </span>
                </p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {datasets.length > 0 && (
    <section class="wrap block" id="datasets" aria-labelledby="datasets-heading">
      <p class="kicker" data-sigil="##">
        datasets
      </p>
      <h2 id="datasets-heading">Datasets</h2>
      <p class="intro">{page.text('intros', 'datasets')}</p>

      <ul class="strip">
        {datasets.map(({ d, pub, paper }) => (
          <li class="reveal card dataset">
            <h3>{d.data.name}</h3>
            <p class="desc">{d.data.description}</p>
            <p class="actions">
              <a
                class="chip"
                href={d.data.url}
                rel="noopener"
                aria-label={`${page.label('dataset')}: ${d.data.name}`}
              >
                {page.label('dataset')}
              </a>
              {paper && (
                <a
                  class="chip"
                  href={paper}
                  rel={paper.startsWith('/') ? undefined : 'noopener'}
                  aria-label={`${page.label('paper')}: ${pub?.data.title}`}
                >
                  {page.label('paper')}
                </a>
              )}
              {pub?.data.abbr && <VenueBadge abbr={pub.data.abbr} />}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 0.5rem;
  }
  .lede {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  /* One rhythm for every section: the map, each group, the datasets. */
  .block {
    padding-block: clamp(2rem, 5vw, 3rem) 0;
  }
  .block:last-of-type {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .block h2 {
    margin-bottom: 0.35rem;
  }
  .intro {
    max-width: var(--measure);
    margin-bottom: 1.25rem;
    color: var(--text-muted);
  }

  /* margin-block, not margin, on both lists: the section carries .wrap,
     whose margin-inline: auto centres it, and a blanket `margin: 0` on a
     scoped selector here once outranked that and uncentred the list. */
  .grid,
  .strip {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin-block: 0;
    padding: 0;
  }
  .grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .strip {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }
  .grid > li {
    display: flex;
  }

  /* ---- approach cards ---- */
  .item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    transition:
      border-color var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .item:hover {
    border-color: var(--sec-line);
    translate: 0 -2px;
  }
  /* The stretched link draws no focus ring of its own (it would circle only
     the title); the card shows it instead. */
  .item:has(.title:focus-visible) {
    outline: 2px solid var(--sec);
    outline-offset: 3px;
  }
  .title:focus-visible {
    outline: none;
  }

  /*
   * A fixed frame, so a wide diagram, a squarer one and a screenshot all take
   * the same height and the titles under them line up across a row. The image
   * is contained, never cropped: a cut-off diagram is a wrong diagram.
   */
  .thumb {
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--bg-2);
    overflow: hidden;
  }
  /* As in Figure.astro: the diagrams are dark line art on transparent, drawn
     for a white page, so they get a light plate. Here the plate is the whole
     frame rather than the image box, so the frames match whatever the image's
     proportions. */
  .thumb.has-plate {
    background: var(--plate);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .item h3,
  .dataset h3 {
    font-size: 1.125rem;
    margin: 0.2rem 0 0;
  }
  .title {
    color: var(--text);
    text-decoration: none;
  }
  .title::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .item:hover .title {
    color: var(--sec-strong);
  }
  .desc {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* Pinned to the bottom, so the link rows of a row of cards line up however
     long each description runs. */
  .foot {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: 0.3rem;
  }
  .venues {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  /* Real links inside the card, lifted above the stretched title link. */
  .above {
    position: relative;
    z-index: 1;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin: 0;
  }
  .more {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--sec);
  }
  .item:hover .arrow {
    margin-left: 0.2em;
  }

  /* ---- datasets ---- */
  .dataset {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .dataset .actions {
    margin-top: auto;
    padding-top: 0.3rem;
    gap: 0.5rem;
  }
</style>
