---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { approachPath } from '../../lib/urls';

const approaches = (await getCollection('approaches')).sort(
  (a, b) => a.data.importance - b.data.importance,
);
---

<Base
  title="approaches"
  description="The approaches developed in ARDoCo: traceability link recovery and inconsistency detection between architecture documentation, models and code."
  section="approaches"
>
  <div class="wrap head">
    <p class="kicker" data-sigil="##">approaches</p>
    <h1>What ARDoCo builds</h1>
    <p class="lede">
      Each approach targets a different pair of artifacts — documentation, architecture models,
      requirements, source code — and most of them compose. They are listed roughly in the order
      they were published.
    </p>
  </div>

  <ul class="wrap grid">
    {
      approaches.map((a) => (
        <li class="reveal">
          <a class="card" href={approachPath(a.id)}>
            <h2>{a.data.title}</h2>
            <p>{a.data.description}</p>
            <span class="more">
              Learn more <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
  }
  .lede {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    list-style: none;
    /* margin-block, not margin: the element also carries .wrap, whose
       margin-inline: auto centres it. A blanket `margin: 0` here outranks
       that (scoped selectors gain a [data-astro-cid] attribute) and the
       list silently loses its centring while the header above keeps it. */
    margin-block: 0;
    padding-bottom: 1rem;
  }
  .grid > li {
    display: flex;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .card:hover {
    border-color: var(--sec-line);
    translate: 0 -2px;
  }

  .card h2 {
    font-size: 1.125rem;
    margin: 0 0 0.4rem;
  }
  .card p {
    flex: 1;
    margin: 0 0 0.9rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .more {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--sec);
  }
  .card:hover .more span {
    margin-left: 0.2em;
  }
</style>
