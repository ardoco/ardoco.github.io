---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubEntry from '../../components/pub/PubEntry.astro';
import { byNewest, byYear } from '../../lib/publications';
import { peopleLinks } from '../../lib/people';
import { fill, getPage, need } from '../../lib/pages';

const pubs = (await getCollection('publications')).sort(byNewest);
const groups = byYear(pubs);
const links = await peopleLinks();

/* The words: src/content/pages/publications.md. */
const page = await getPage('publications');
---

<Base {...page.meta()} section="publications">
  <div class="wrap head">
    <p class="kicker" data-sigil="##">
      publications
    </p>
    <h1>Publications</h1>
    {/* The count, then the body, as one paragraph: the body renders its own
         <p>, set inline here. */}
    <div class="lede">
      {fill(need(page.data.count, 'publications.count'), { count: pubs.length })} <page.Content />
    </div>

    <div class="filter">
      <label class="sr-only" for="pubsearch">
        Filter publications
      </label>
      <input
        id="pubsearch"
        type="search"
        placeholder="Filter by title, author or venue…"
        autocomplete="off"
        hidden
      />
    </div>
    <p class="no-results" hidden>
      {page.label('noResults')}
    </p>
  </div>

  <div class="wrap list">
    {groups.map((g) => (
      <section class="year" data-year={g.year}>
        <h2 class="year-head mono">{g.year}</h2>
        {g.pubs.map((pub) => (
          <div class="row" data-search={pub.data.searchText}>
            <PubEntry pub={pub} links={links} />
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>

<script>
  /*
   * Client-side filter. The input ships `hidden` and this script reveals it, so
   * without JS there is no dead control — the full list is there either way.
   *
   * Reading location.hash on load preserves the old al-folio behaviour where
   * /publications/#lissa arrived with the filter pre-filled.
   */
  const input = document.querySelector<HTMLInputElement>('#pubsearch');
  const empty = document.querySelector<HTMLElement>('.no-results');
  const rows = [...document.querySelectorAll<HTMLElement>('.row')];
  const years = [...document.querySelectorAll<HTMLElement>('.year')];

  if (input && empty) {
    input.hidden = false;

    const apply = (raw: string) => {
      const q = raw.trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const hit = q === '' || (row.dataset.search ?? '').includes(q);
        row.hidden = !hit;
        if (hit) shown += 1;
      }
      // Hide a year heading once everything under it is filtered out.
      for (const year of years) {
        year.hidden = !year.querySelector('.row:not([hidden])');
      }
      empty.hidden = shown > 0;
    };

    input.addEventListener('input', () => apply(input.value));

    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    // Only treat the hash as a filter when it is not an entry's own id, so
    // deep links to a single publication still scroll to it.
    if (hash && !document.getElementById(hash)) {
      input.value = hash;
      apply(hash);
    }
  }
</script>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 1rem;
  }
  .lede {
    max-width: var(--measure);
    /* What the paragraph it replaces had from base.css: the body's own <p>
       is inline here, so the block that wraps the lines is this one. */
    margin-bottom: 1em;
    text-wrap: pretty;
    color: var(--text-muted);
  }
  .lede :global(p) {
    display: inline;
  }
  .filter {
    margin-top: 1.5rem;
  }
  #pubsearch {
    width: min(100%, 28rem);
    padding: 0.6rem 0.9rem;
    font: inherit;
    font-size: var(--fs-small);
    color: var(--text);
    background: var(--bg-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
  }
  #pubsearch:focus-visible {
    border-color: var(--sec-line);
  }
  .no-results {
    margin: 1rem 0 0;
    color: var(--text-faint);
    font-size: var(--fs-small);
  }

  .list {
    padding-bottom: 1rem;
  }
  .year {
    margin-top: 2.25rem;
  }
  /* A flat section marker rather than a sticky bar, as in aca-theme: a sticky
     one floats over the entries as you scroll, and stacks up wherever two
     years sit close together. The rule is drawn by ::after so it fills
     whatever space is left beside the number, at any width. */
  .year-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--sec);
  }
  .year-head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
</style>
