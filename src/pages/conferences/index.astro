---
import { redirectResponse } from '../../lib/redirect';
import { getPage, need } from '../../lib/pages';

/*
 * /conferences/ listed the paper pages, but /publications/ already links each
 * one (title and "Details" chip) and "conferences" was a misnomer for a list
 * that includes journal papers. The list is folded into /publications/; this
 * stub keeps the URL, which has been published since the Astro migration.
 */
const page = await getPage('publications');
return redirectResponse('/publications/', need(page.data.title, 'publications.title'));
---
