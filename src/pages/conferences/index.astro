---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VenueBadge from '../../components/pub/VenueBadge.astro';
import { listed } from '../../lib/conferences';
import { conferencePath } from '../../lib/urls';

/*
 * This page is new. The old site had no conferences index: the eleven paper
 * pages were reachable only from a navbar dropdown, and the page that defined
 * that dropdown had no permalink, so Jekyll published it at the accidental
 * address /_pages/conferences/ (which now redirects here).
 */
const all = listed(await getCollection('conferences'));
const entries = await Promise.all(
  all.map(async (c) => ({
    c,
    pub: c.data.publication ? await getEntry(c.data.publication) : undefined,
  })),
);
---

<Base
  title="conferences"
  description="Paper pages for ARDoCo publications: abstracts, slides, replication packages and the approaches each one builds on."
  section="conferences"
>
  <div class="wrap head">
    <p class="kicker" data-sigil="##">conferences</p>
    <h1>Papers &amp; presentations</h1>
    <p class="lede">
      One page per publication, with the abstract, the approaches it builds on, and links to the
      paper, slides and replication package.
    </p>
  </div>

  <ul class="wrap list">
    {
      entries.map(({ c, pub }) => (
        <li class="reveal">
          <div class="badge">{pub?.data.abbr && <VenueBadge abbr={pub.data.abbr} />}</div>
          <div>
            <h2>
              <a href={conferencePath(c.id)}>{c.data.title}</a>
            </h2>
            <p class="meta">
              {c.data.pubEmoji && <span>{c.data.pubEmoji} </span>}
              {c.data.conferenceName ?? c.data.pubPrefixText}
              {c.data.inPress && <span class="tag">to appear</span>}
            </p>
          </div>
          <span class="year">{c.data.year}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
  }
  .lede {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .list {
    list-style: none;
    /* margin-block, not margin: the element also carries .wrap, whose
       margin-inline: auto centres it. A blanket `margin: 0` here outranks
       that (scoped selectors gain a [data-astro-cid] attribute) and the
       list silently loses its centring while the header above keeps it. */
    margin-block: 0;
    padding-bottom: 1rem;
  }
  .list > li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) max-content;
    gap: 0.3rem 1rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .badge {
    padding-top: 0.15rem;
  }
  h2 {
    font-size: 1.0625rem;
    margin: 0 0 0.25rem;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--sec-strong);
  }
  .meta {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-faint);
  }
  .tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1em 0.5em;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    border: 1px solid var(--amber-line);
    border-radius: 999px;
    color: var(--amber);
  }
  .year {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-faint);
  }

  @media (max-width: 34rem) {
    .list > li {
      grid-template-columns: minmax(0, 1fr) max-content;
    }
    .badge {
      grid-column: 1 / -1;
    }
  }
</style>
