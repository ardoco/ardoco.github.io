---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { featured } from '../lib/conferences';
import { approachPath, conferencePath } from '../lib/urls';
import { SITE } from '../consts';
import Email from '../components/Email.astro';
import { getPage, siteText } from '../lib/pages';

const approaches = (await getCollection('approaches')).sort(
  (a, b) => a.data.importance - b.data.importance,
);

const conferences = featured(await getCollection('conferences'));
const highlights = await Promise.all(
  conferences.map(async (c) => ({
    c,
    authors: await Promise.all(c.data.authors.map((ref) => getEntry(ref))),
  })),
);

/* The words: the heading and the line under it in src/content/pages/site/site.md,
   everything else in home.md, whose body is the introduction, and the three
   rich blocks beside it in home/. */
const { title, tagline } = await siteText();
const home = await getPage('home');
const { label } = home;
const { Content: Affiliation } = await getPage('home/affiliation');
const { Content: Poster } = await getPage('home/poster');
const { Content: Links } = await getPage('home/links');
---

<Base>
  <section class="hero wrap">
    <img class="logo" src="/assets/img/logo.png" alt="" width="480" height="600" />
    <h1>{title}</h1>
    <p class="tagline">{tagline}</p>
    <p class="actions">
      <a class="chip primary" href="/approaches/">
        {label('approaches')}
      </a>
      <a class="chip" href="/publications/">
        {label('publications')}
      </a>
      <a class="chip" href={SITE.repo} rel="noopener">
        {label('github')}
      </a>
    </p>
  </section>

  <section class="wrap intro">
    <!-- NEVER CHANGE THIS LINE B. It is used as delimiter for the page at mcse.kastel.kit.edu -->

    <home.Content />

    <!-- NEVER CHANGE THIS LINE E. It is used as delimiter for the page at mcse.kastel.kit.edu -->

    <div class="affiliation">
      <Affiliation />
    </div>
  </section>

  <section class="wrap section" data-section="approaches" id="approaches">
    <p class="kicker" data-sigil="##">
      approaches
    </p>
    <h2>What we build</h2>
    <ul class="approach-grid">
      {approaches.map((a) => (
        <li class="reveal">
          <a href={approachPath(a.id)}>
            <strong>{a.data.title}</strong>
            <span>{a.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" data-section="papers" id="publications">
    <p class="kicker" data-sigil="##">
      publications
    </p>
    <h2>Relevant and recent publications</h2>
    <p class="sub">{home.text('intros', 'publications')}</p>
    <ul class="pub-list">
      {highlights.map(({ c, authors }) => (
        <li class="reveal">
          <a href={conferencePath(c.id)}>
            {c.data.pubEmoji && <span class="emoji">{c.data.pubEmoji}</span>}
            {c.data.pubPrefixText}
            {c.data.pubShortName ? ` ${c.data.pubShortName}` : ''}
          </a>
          {c.data.additionalPresentations.length > 0 && (
            <span class="extra">
              {' '}
              {home.plural('presentations', c.data.additionalPresentations.length)}{' '}
              {c.data.additionalPresentations.map((p, i) => (
                <Fragment>
                  {i > 0 && ', '}
                  <a href={p.url} rel="noopener">
                    {p.shortName ?? p.name}
                  </a>
                </Fragment>
              ))}
            </span>
          )}
          : <strong>{c.data.title}</strong>
          {authors.length > 0 && (
            <span class="by">
              {' '}
              {c.data.pubBylineConnector} {authors.map((a) => a.data.name).join(', ')}
            </span>
          )}
        </li>
      ))}
      <li>
        <Poster />
      </li>
    </ul>
  </section>

  <section class="wrap section" id="links">
    <p class="kicker" data-sigil="##">
      links
    </p>
    <h2>Important links</h2>
    {/* Two lists that read as one: the rows from home/links.md, then the
        contact row, which has to be the template's (see Email.astro). */}
    <div class="links">
      <Links />
      <ul>
        <li>
          {label('contact')} <Email address={SITE.email} />
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(2.5rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .logo {
    width: auto;
    height: clamp(5rem, 12vw, 7.5rem);
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: var(--fs-h1);
    letter-spacing: -0.03em;
    margin: 0 0 0.35rem;
  }
  .tagline {
    max-width: 34ch;
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 0;
  }
  .chip.primary {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }

  .intro {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  /* :global because the paragraphs are Markdown bodies (home.md and
     home/affiliation.md), which the scoping attribute never reaches. */
  .intro :global(p) {
    color: var(--text-muted);
  }
  .affiliation {
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .approach-grid a {
    display: block;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--bg-1);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .approach-grid a:hover {
    border-color: var(--sec-line);
    translate: 0 -2px;
  }
  .approach-grid strong {
    display: block;
    margin-bottom: 0.2rem;
  }
  .approach-grid span {
    font-size: var(--fs-small);
    color: var(--text-faint);
  }

  .sub {
    color: var(--text-faint);
    font-size: var(--fs-small);
    margin-bottom: 1rem;
  }
  /* .links is a wrapper around two lists, the Markdown one from
     home/links.md and the contact row; with no margin between them they read
     as the one list they replace. */
  .pub-list,
  .links :global(ul) {
    padding-left: 1.15rem;
    margin: 0;
  }
  .pub-list li,
  .links :global(li) {
    margin-bottom: 0.65rem;
    color: var(--text-muted);
  }
  /* The poster row is a Markdown body (home/poster.md); its own <p> runs
     inline, so the row reads as the plain list item it replaces. */
  .pub-list :global(p) {
    display: inline;
  }
  .pub-list strong {
    color: var(--text);
  }
  .by,
  .extra {
    font-size: var(--fs-small);
  }
  .emoji {
    margin-right: 0.25em;
  }
</style>
