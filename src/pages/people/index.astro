---
import Base from '../../layouts/Base.astro';
import { members } from '../../lib/people';
import { intrinsic } from '../../lib/images';
import Email from '../../components/Email.astro';
import { getPage } from '../../lib/pages';

const people = (await members()).map((p) => ({ ...p, size: intrinsic(p.image) }));

/* The words: src/content/pages/people.md. */
const page = await getPage('people');
const { label } = page;
---

<Base {...page.meta()} section="people">
  <div class="wrap head">
    <p class="kicker" data-sigil="##">
      people
    </p>
    <h1>Who works on ARDoCo</h1>
    <div class="lede">
      <page.Content />
    </div>
  </div>

  <ul class="wrap grid">
    {people.map((p) => (
      /*
       * The id is the anchor: publication author links point at
       * /people/#dominik-fuchß, an address Jekyll generated from the
       * "## Dominik Fuchß" headings. It has to keep resolving.
       */
      <li class="card reveal" id={p.id}>
        <img
          src={p.image}
          alt=""
          width={p.size.width}
          height={p.size.height}
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2>
            {p.name}
            {p.orcid && (
              <a
                class="orcid"
                href={`https://orcid.org/${p.orcid}`}
                rel="noopener"
                title={`${label('orcid')} ${p.orcid}`}
              >
                <span class="sr-only">
                  {label('orcid')} of {p.name}
                </span>
                iD
              </a>
            )}
          </h2>
          <ul class="links">
            {p.kitUrl && (
              <li>
                <a class="chip" href={p.kitUrl} rel="noopener">
                  {label('kitUrl')}
                </a>
              </li>
            )}
            {p.email && (
              <li>
                <Email class="chip" address={p.email} />
              </li>
            )}
          </ul>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
  }
  .lede {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    list-style: none;
    /* margin-block, not margin: the element also carries .wrap, whose
       margin-inline: auto centres it. A blanket `margin: 0` here outranks
       that (scoped selectors gain a [data-astro-cid] attribute) and the
       list silently loses its centring while the header above keeps it. */
    margin-block: 0;
    padding-bottom: 1rem;
  }
  .card {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .card img {
    width: 5.5rem;
    height: 5.5rem;
    flex: none;
    object-fit: cover;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
  }
  h2 {
    font-size: 1.0625rem;
    margin: 0 0 0.5rem;
  }
  /* The same iD mark as the bylines on the paper pages (c/[slug].astro). */
  .orcid {
    display: inline-block;
    margin-left: 0.3em;
    padding: 0.05em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--green-line);
    border-radius: var(--radius-s);
    color: var(--green);
    vertical-align: 0.15em;
  }
  .orcid:hover {
    background: var(--green-dim);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
